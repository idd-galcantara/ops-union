    "test": "tsx --test src/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "express": "^4.22.3",
    "undici": "^6.29.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
